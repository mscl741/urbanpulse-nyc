# --- Grok (xAI) — vision, chat, TTS ---
# Get a key at https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4.7
# Optional Grok Voice (POST /v1/tts). Default voice: eve
# GROK_TTS_VOICE=eve

# --- Gemini (Google) — vision + TTS when ACTIVE_AI=gemini ---
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.0-flash
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# --- AI engine switch (comment out the one you don't want; restart Streamlit after) ---
ACTIVE_AI=grok
# ACTIVE_AI=gemini

# --- Google Maps (recommended for phones) ---
# Enable "Maps JavaScript API" + "Geocoding API" in Google Cloud, then paste the key.
# Without this, the live map still works on OpenStreetMap streets.
# GOOGLE_MAPS_API_KEY=

# --- Tiger Data (TimescaleDB / Postgres) ---
# DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# --- NASA POWER weather aid (flood / rain observations) ---
# Free — no key required. https://power.larc.nasa.gov/
# Optional override if NASA ever requires a token (leave blank):
# NASA_POWER_API_KEY=

# --- Safe notifications ---
NOTIFY_PLACEHOLDER_TO=urbanpulse-mock@example.com
