# --- Grok (xAI) ---
# Get a key at https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4.7

# --- Tiger Data (TimescaleDB / Postgres) ---
# Paste your Tiger Data connection string, e.g.:
# DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
#
# If unset, UrbanPulse uses local SQLite (./urbanpulse.db) so you can still test inserts.
# DATABASE_URL=

# --- Safe notifications ---
# Mock send + mailto default to this inbox (NOT a real city mailbox)
NOTIFY_PLACEHOLDER_TO=urbanpulse-mock@example.com

# Optional SMTP — only allowed to send TO the placeholder address above
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=urbanpulse@localhost
